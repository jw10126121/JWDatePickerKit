require "fileutils"
require "json"

private_pod_release = lambda do
  project_root = File.expand_path("..", __dir__)
  podspec_path = File.join(project_root, "JWDatePickerKit.podspec")
  specs_root = ENV.fetch(
    "JW_PUBLIC_SPECS_PATH",
    File.expand_path("../../JWPublicSpecs", __dir__)
  )

  UI.user_error!("找不到 Podspec: #{podspec_path}") unless File.file?(podspec_path)
  UI.user_error!("找不到 JWPublicSpecs Git 仓库: #{specs_root}") unless Dir.exist?(File.join(specs_root, ".git"))

  git = lambda do |directory, *arguments|
    sh("git", "-C", directory, *arguments, log: false).strip
  end

  project_status = git.call(project_root, "status", "--porcelain", "--untracked-files=all")
  UI.user_error!("请先提交 JWDatePickerKit 源码改动，再执行发布。") unless project_status.empty?

  spec = JSON.parse(sh("pod", "ipc", "spec", podspec_path, log: false))
  version = spec.fetch("version")
  source_tag = spec.fetch("source", {}).fetch("tag", nil)
  source_git = spec.fetch("source", {}).fetch("git", nil)
  UI.user_error!("Podspec 版本必须使用 x.y.z 格式。") unless version.match?(/\A\d+\.\d+\.\d+\z/)
  UI.user_error!("Podspec source.tag 必须与版本号 #{version} 一致。") unless source_tag == version
  UI.user_error!("Podspec source.git 必须指向 Gitee 项目仓库。") unless source_git == "https://gitee.com/jw10126121/JWDatePickerKit.git"

  project_branch = git.call(project_root, "branch", "--show-current")
  UI.user_error!("请在有名称的分支上发布。") if project_branch.empty?
  project_head = git.call(project_root, "rev-parse", "HEAD")

  source_remotes = {
    "origin" => git.call(project_root, "remote", "get-url", "origin"),
    "gitee" => git.call(project_root, "remote", "get-url", "gitee")
  }
  UI.user_error!("gitee 远端未指向 JWDatePickerKit Gitee 仓库。") unless source_remotes["gitee"].end_with?("/jw10126121/JWDatePickerKit.git")

  source_remotes.each_key do |remote|
    remote_head = git.call(project_root, "ls-remote", remote, "refs/heads/#{project_branch}").split.first
    UI.user_error!("当前源码提交尚未推送到 #{remote}/#{project_branch}。") unless remote_head == project_head
  end

  specs_branch = git.call(specs_root, "branch", "--show-current")
  UI.user_error!("JWPublicSpecs 当前处于 detached HEAD。") if specs_branch.empty?
  specs_remote = git.call(specs_root, "remote", "get-url", "origin").sub(/\.git\z/, "")
  unless specs_remote.end_with?("/JWPublicSpecs", ":JWPublicSpecs")
    UI.user_error!("Specs 仓库 origin 不是 JWPublicSpecs: #{specs_remote}")
  end

  specs_status = git.call(specs_root, "status", "--porcelain", "--untracked-files=all")
  UI.user_error!("请先提交或清理 JWPublicSpecs 中的本地改动。") unless specs_status.empty?

  sh("git", "-C", specs_root, "fetch", "origin")
  specs_head = git.call(specs_root, "rev-parse", "HEAD")
  specs_remote_head = git.call(specs_root, "rev-parse", "origin/#{specs_branch}")
  UI.user_error!("JWPublicSpecs 本地分支与远端不同步，请先同步后重试。") unless specs_head == specs_remote_head

  relative_spec_path = File.join("Specs", "JWDatePickerKit", version, "JWDatePickerKit.podspec")
  published_spec_path = File.join(specs_root, relative_spec_path)
  UI.user_error!("Specs 中已存在版本 #{version}，请提升 Podspec 版本号。") if File.exist?(published_spec_path)

  exact_tag = "refs/tags/#{version}"
  peeled_tag = "#{exact_tag}^{}"
  local_tag = git.call(project_root, "tag", "--list", version).empty? ? nil :
              git.call(project_root, "rev-parse", "#{version}^{commit}")

  UI.user_error!("本地 tag #{version} 已指向其他提交，停止发布。") if local_tag && local_tag != project_head
  sh("git", "-C", project_root, "tag", version) unless local_tag

  source_remotes.each_key do |remote|
    remote_tags = git.call(
      project_root,
      "ls-remote",
      "--tags",
      remote,
      exact_tag,
      peeled_tag
    ).lines
    remote_tag_line = remote_tags.find { |line| line.split("\t").last&.strip == peeled_tag } ||
                      remote_tags.find { |line| line.split("\t").last&.strip == exact_tag }
    remote_tag = remote_tag_line&.split&.first

    if remote_tag
      UI.user_error!("#{remote} 上的 tag #{version} 已指向其他提交，停止发布。") unless remote_tag == project_head
    else
      sh("git", "-C", project_root, "push", remote, "refs/tags/#{version}")
    end
  end

  sh(
    "pod",
    "spec",
    "lint",
    podspec_path,
    "--private",
    "--allow-warnings",
    "--sources=https://gitee.com/jw10126121/JWPublicSpecs.git,https://cdn.cocoapods.org/"
  )

  FileUtils.mkdir_p(File.dirname(published_spec_path))
  FileUtils.cp(podspec_path, published_spec_path)
  sh("git", "-C", specs_root, "add", "--", relative_spec_path)
  sh("git", "-C", specs_root, "commit", "-m", "Publish JWDatePickerKit #{version}", "--", relative_spec_path)
  sh("git", "-C", specs_root, "push", "origin", specs_branch)

  UI.success("JWDatePickerKit #{version} 已发布到 JWPublicSpecs。")
end

platform :ios do
  desc "发布 JWDatePickerKit 到 JWPublicSpecs Specs 仓库"
  lane :release_private_pod do
    private_pod_release.call
  end
end

CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/JWDatePickerKit" "${PODS_CONFIGURATION_BUILD_DIR}/PGDatePickerFix" "${PODS_CONFIGURATION_BUILD_DIR}/PGPickerView" "${PODS_CONFIGURATION_BUILD_DIR}/SnapKit" "${PODS_CONFIGURATION_BUILD_DIR}/XBDialog"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/JWDatePickerKit/JWDatePickerKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/PGDatePickerFix/PGDatePicker.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/PGPickerView/PGPickerView.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SnapKit/SnapKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/XBDialog/XBDialog.framework/Headers"
OTHER_LDFLAGS = $(inherited) -framework "JWDatePickerKit" -framework "PGDatePicker" -framework "PGPickerView" -framework "SnapKit" -framework "UIKit" -framework "XBDialog"
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
